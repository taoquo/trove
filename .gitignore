# Build output
build/
dist/
coverage/
*.test
*.log

# Screenshots are captured locally by the gate; the design documents are versioned.
docs/screenshots/

# Pinned Go toolchain and module cache (see .toolchain/env.sh).
# env.sh records the pin and checksum, so it is the only tracked file here.
.toolchain/*
!.toolchain/env.sh

# MyGo's Windows resource object; generated per build.
mygo_windows_*.syso

# Site tooling output. The site and its deploy config are versioned; wrangler's
# local state and installed packages are not.
.wrangler/
site/node_modules/

# Local tooling and editor state
.claude/
.DS_Store
._*
.idea/
.vscode/
*.swp
